-- KEYBIND INPUT HANDLER
-- =============================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if isSettingUnlockKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local key = input.KeyCode
            
            if key == Enum.KeyCode.LeftShift or key == Enum.KeyCode.RightShift or
               key == Enum.KeyCode.LeftControl or key == Enum.KeyCode.RightControl or
               key == Enum.KeyCode.LeftAlt or key == Enum.KeyCode.RightAlt then
                return
            end
            
            local ok, msg = setUnlockKeybind(key)
            if ok then
                isSettingUnlockKey = false
                UnlockKeyBtn.Text = "⌨️ Unlock Key: " .. getKeyName(key)
                UnlockKeyBtn.BackgroundColor3 = Color3.fromRGB(60, 100, 140)
                SL.Text = "✅ Gán phím " .. getKeyName(key) .. " cho Unlock"
                SL.TextColor3 = Color3.fromRGB(80, 255, 110)
            else
                SL.Text = "❌ " .. msg
                SL.TextColor3 = Color3.fromRGB(255, 80, 80)
                isSettingUnlockKey = false
                UnlockKeyBtn.Text = unlockKeybind and ("⌨️ Unlock Key: " .. getKeyName(unlockKeybind)) or "🔓 Set Unlock Key"
                UnlockKeyBtn.BackgroundColor3 = unlockKeybind and Color3.fromRGB(60, 100, 140) or Color3.fromRGB(60, 60, 80)
            end
        end
        return
    end
    
    if isSettingKeybind and settingKeybindFor then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local key = input.KeyCode
            
            if key == Enum.KeyCode.LeftShift or key == Enum.KeyCode.RightShift or
               key == Enum.KeyCode.LeftControl or key == Enum.KeyCode.RightControl or
               key == Enum.KeyCode.LeftAlt or key == Enum.KeyCode.RightAlt then
                return
            end
            
            local ok, msg = setKeybind(settingKeybindFor, key)
            if ok then
                local emote = findEmoteById(settingKeybindFor)
                if emote then
                    SL.Text = "✅ Gán phím " .. getKeyName(key) .. " cho " .. emote.name
                    SL.TextColor3 = Color3.fromRGB(80, 255, 110)
                end
            else
                SL.Text = "❌ " .. (msg or "Lỗi")
                SL.TextColor3 = Color3.fromRGB(255, 80, 80)
            end
            
            isSettingKeybind = false
            settingKeybindFor = nil
            refreshEmoteList()
        end
        return
    end
    
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == unlockKeybind then
            if unlockEmote() then
                PauseBtn.Text = "⏸ Pause"
                PauseBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 10)
                SL.Text = "🔓 Unlocked (" .. getKeyName(unlockKeybind) .. ")"
                SL.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
            return
        end
        
        local emoteId = keybinds[input.KeyCode]
        if emoteId then
            local emote = findEmoteById(emoteId)
            if emote then
                local track, err = PlayEmoteDirect(emote.id)
                if track then
                    isLocked = true
                    startLoop()
                    SL.Text = "✅ " .. emote.name .. " (" .. getKeyName(input.KeyCode) .. ")"
                    SL.TextColor3 = Color3.fromRGB(80, 255, 110)
                end
            end
        end
    end
end)

