-- =============================================
-- STORAGE FUNCTIONS
-- =============================================
local function loadFavorites()
    ensureFolder()
    if isfile("EmoteAnywhere/favorites.json") then
        pcall(function()
            favorites = HttpService:JSONDecode(readfile("EmoteAnywhere/favorites.json"))
        end)
    end
end

local function saveFavorites()
    ensureFolder()
    writefile("EmoteAnywhere/favorites.json", HttpService:JSONEncode(favorites))
end

local function loadCustomEmotes()
    ensureFolder()
    if isfile("EmoteAnywhere/custom_emotes.json") then
        pcall(function()
            customEmotes = HttpService:JSONDecode(readfile("EmoteAnywhere/custom_emotes.json"))
        end)
    end
end

local function saveCustomEmotes()
    ensureFolder()
    writefile("EmoteAnywhere/custom_emotes.json", HttpService:JSONEncode(customEmotes))
end

local function loadKeybinds()
    ensureFolder()
    if isfile("EmoteAnywhere/keybinds.json") then
        pcall(function()
            local data = HttpService:JSONDecode(readfile("EmoteAnywhere/keybinds.json"))
            keybinds = {}
            emoteKeybinds = {}
            for _, bind in ipairs(data) do
                local keyCode = Enum.KeyCode[bind.key]
                if keyCode then
                    keybinds[keyCode] = bind.emoteId
                    emoteKeybinds[bind.emoteId] = keyCode
                end
            end
        end)
    end
end

local function saveKeybinds()
    ensureFolder()
    local saveData = {}
    for keyCode, emoteId in pairs(keybinds) do
        local keyName = tostring(keyCode):gsub("Enum%.KeyCode%.", "")
        table.insert(saveData, { key = keyName, emoteId = emoteId })
    end
    writefile("EmoteAnywhere/keybinds.json", HttpService:JSONEncode(saveData))
end

local function loadSettings()
    ensureFolder()
    if isfile("EmoteAnywhere/settings.json") then
        pcall(function()
            local data = HttpService:JSONDecode(readfile("EmoteAnywhere/settings.json"))
            if data.unlockKey then
                unlockKeybind = Enum.KeyCode[data.unlockKey]
            end
        end)
    end
end

local function saveSettings()
    ensureFolder()
    local settings = {
        unlockKey = unlockKeybind and tostring(unlockKeybind):gsub("Enum%.KeyCode%.", "") or nil
    }
    writefile("EmoteAnywhere/settings.json", HttpService:JSONEncode(settings))
end

-- =============================================
-- HELPER FUNCTIONS
-- =============================================
local function getKeyName(keyCode)
    return tostring(keyCode):gsub("Enum.KeyCode.", "")
end

local function isFavorite(emoteId)
    for _, fav in ipairs(favorites) do
        if fav == emoteId then return true end
    end
    return false
end

local function toggleFavorite(emoteId)
    if isFavorite(emoteId) then
        for i, fav in ipairs(favorites) do
            if fav == emoteId then
                table.remove(favorites, i)
                break
            end
        end
    else
        table.insert(favorites, emoteId)
    end
    saveFavorites()
end

local function findEmoteById(emoteId)
    for _, e in ipairs(allEmotes) do
        if e.id == emoteId then return e end
    end
    return nil
end

local function buildEmoteList()
    allEmotes = {}
    -- Add defaults
    for _, p in ipairs(defaultPresets) do
        table.insert(allEmotes, {
            name = p.name,
            id = p.id,
            custom = false
        })
    end
    -- Add customs
    for _, c in ipairs(customEmotes) do
        table.insert(allEmotes, {
            name = c.name,
            id = c.id,
            custom = true
        })
    end
end

local function addCustomEmote(name, id)
    for _, e in ipairs(customEmotes) do
        if e.id == id then
            return false, "ID đã tồn tại!"
        end
    end
    table.insert(customEmotes, { name = name, id = id })
    saveCustomEmotes()
    buildEmoteList()
    return true, "Đã thêm " .. name
end

local function removeCustomEmote(id)
    for i, e in ipairs(customEmotes) do
        if e.id == id then
            table.remove(customEmotes, i)
            saveCustomEmotes()
            buildEmoteList()
            -- Remove keybind too
            local keyCode = emoteKeybinds[id]
            if keyCode then
                keybinds[keyCode] = nil
                emoteKeybinds[id] = nil
                saveKeybinds()
            end
            return true
        end
    end
    return false
end

-- =============================================
-- EMOTE PLAYBACK
-- =============================================
local function isDefault(animId)
    local id = animId:match("%d+")
    for _, d in ipairs(DEFAULTS) do
        if d == id then return true end
    end
    return false
end

local function PlayEmote(animId)
    if not Char or not Hum or not Animator then
        return nil, "Character not ready"
    end
    
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. animId
    
    local ok, track = pcall(function()
        return Animator:LoadAnimation(anim)
    end)
    
    if not ok or not track then
        return nil, "Failed to load"
    end
    
    if currentTrack then
        pcall(function() currentTrack:Stop() end)
    end
    
    currentTrack = track
    
    -- Set priority cao để không bị override bởi default animations
    track.Priority = Enum.AnimationPriority.Action
    
    track:Play()
    return track
end

local function unlockEmote()
    if currentTrack then
        pcall(function() currentTrack:Stop() end)
        currentTrack = nil
    end
    isLocked = false
    isPaused = false
    if loopConn then
        loopConn:Disconnect()
        loopConn = nil
    end
    return true
end

local function startLoop()
    if loopConn then loopConn:Disconnect() end
    
    -- Loop bằng Heartbeat để check liên tục
    loopConn = RunService.Heartbeat:Connect(function()
        if not isLocked or isPaused then return end
        if currentTrack then
            -- Nếu animation dừng, play lại ngay
            if not currentTrack.IsPlaying then
                currentTrack:Play()
            end
            -- Nếu gần hết (99% length), restart để không bị gap
            if currentTrack.TimePosition >= currentTrack.Length * 0.99 then
                currentTrack:Stop()
                currentTrack:Play()
            end
        end
    end)
    
    -- Thêm listener khi animation stopped
    if currentTrack then
        currentTrack.Stopped:Connect(function()
            if isLocked and not isPaused then
                -- Restart ngay khi dừng
                task.wait(0.05)
                if currentTrack and isLocked and not isPaused then
                    currentTrack:Play()
                end
            end
        end)
    end
end

