local stateChangedConn = nil

local function setupStateHandler()
    -- Cleanup old connection
    if stateChangedConn then
        stateChangedConn:Disconnect()
    end
    
    -- Listen for state changes (jumping, falling, swimming, etc.)
    stateChangedConn = Hum.StateChanged:Connect(function(oldState, newState)
        -- Khi state thay đổi và đang lock, đảm bảo animation vẫn chạy
        if isLocked and not isPaused and currentTrack then
            task.wait(0.1) -- Đợi state settle
            if not currentTrack.IsPlaying then
                currentTrack:Play()
            end
        end
    end)
end

LP.CharacterAdded:Connect(function(c)
    Char = c
    Hum = c:WaitForChild("Humanoid")
    Animator = Hum:WaitForChild("Animator")
    
    if loopConn then loopConn:Disconnect() end
    isLocked = false
    isPaused = false
    currentTrack = nil
    
    -- Setup state handler for new character
    setupStateHandler()
    
    SL.Text = "✅ Ready after respawn"
    SL.TextColor3 = Color3.fromRGB(80, 255, 110)
    PauseBtn.Text = "⏸ Pause"
    PauseBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 10)
end)

