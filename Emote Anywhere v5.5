local function getEmoteOrder(emoteId)
    for i, id in ipairs(customOrder) do
        if id == emoteId then return i end
    end
    return 99999 -- Default to end if not in custom order
end

local function setEmoteOrder(emoteId, newPosition)
    -- Remove from current position
    for i, id in ipairs(customOrder) do
        if id == emoteId then
            table.remove(customOrder, i)
            break
        end
    end
    
    -- Insert at new position
    table.insert(customOrder, newPosition, emoteId)
    saveCustomOrder()
end

local function ensureEmoteInOrder(emoteId)
    -- Add emote to order if not already there
    local found = false
    for _, id in ipairs(customOrder) do
        if id == emoteId then
            found = true
            break
        end
    end
    if not found then
        table.insert(customOrder, emoteId)
    end
end

local function getAllEmotes()
    allEmotes = {}
    -- Add default emotes (skip if hidden)
    for _, e in ipairs(defaultPresets) do
        if not isHidden(e.id) then
            table.insert(allEmotes, e)
        end
    end
    -- Add custom emotes
    for _, e in ipairs(customEmotes) do
        table.insert(allEmotes, e)
    end
    return allEmotes
end

local function getFilteredEmotes()
    local filtered = {}
    if currentFilter == "all" then
        return getAllEmotes()
    elseif currentFilter == "favorites" then
        for _, emote in ipairs(getAllEmotes()) do
            if isFavorite(emote.id) then
                table.insert(filtered, emote)
            end
        end
    elseif currentFilter == "custom" then
        for _, emote in ipairs(getAllEmotes()) do
            if emote.custom then
                table.insert(filtered, emote)
            end
        end
    end
    return filtered
end

-- =============================================
-- NEW: ALPHABETICAL SORTING WITH HEADERS
-- =============================================
local function getFirstLetter(name)
    -- Remove emojis and special chars, get first real letter
    local cleaned = name:gsub("[^%w%s]", "") -- Remove non-alphanumeric
    local firstChar = cleaned:sub(1, 1):upper()
    
    -- If starts with number or nothing, return #
    if firstChar:match("%d") or firstChar == "" then
        return "#"
    end
    
    return firstChar
end

local function sortEmotesAlphabetically(emotes)
    -- Sort by name (using custom names if available)
    table.sort(emotes, function(a, b)
        local nameA = getEmoteName(a)
        local nameB = getEmoteName(b)
        return nameA:upper() < nameB:upper()
    end)
    
    -- Group by first letter
    local grouped = {}
    local letters = {}
    
    for _, emote in ipairs(emotes) do
        local emoteName = getEmoteName(emote)
        local letter = getFirstLetter(emoteName)
        
        if not grouped[letter] then
            grouped[letter] = {}
            table.insert(letters, letter)
        end
        
        table.insert(grouped[letter], emote)
    end
    
    -- Sort letters (# at end)
    table.sort(letters, function(a, b)
        if a == "#" then return false end
        if b == "#" then return true end
        return a < b
    end)
    
    return grouped, letters
end

local function sortEmotesByCustomOrder(emotes)
    -- Ensure all emotes are in order list
    for _, emote in ipairs(emotes) do
        ensureEmoteInOrder(emote.id)
    end
    
    -- Sort by custom order
    table.sort(emotes, function(a, b)
        return getEmoteOrder(a.id) < getEmoteOrder(b.id)
    end)
    
    return emotes
end

local function findEmoteById(id)
    for _, emote in ipairs(getAllEmotes()) do
        if emote.id == id then return emote end
    end
    return nil
end

