-- FIXED: Save keybinds properly
local function saveKeybinds()
    ensureFolder()
    local saveData = {}
    for keyCode, emoteId in pairs(keybinds) do
        -- Lưu tên của KeyCode thay vì tostring(keyCode)
        local keyName = tostring(keyCode):gsub("Enum%.KeyCode%.", "")
        table.insert(saveData, {
            key = keyName,
            emoteId = emoteId
        })
    end
    local data = HttpService:JSONEncode(saveData)
    writefile(KEYBINDS_PATH, data)
    print("💾 Saved " .. #saveData .. " keybinds")
end

-- FIXED: Load keybinds properly
local function loadKeybinds()
    ensureFolder()
    if isfile(KEYBINDS_PATH) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(KEYBINDS_PATH))
        end)
        if ok and data then
            keybinds = {}
            emoteKeybinds = {}
            for _, bind in ipairs(data) do
                -- Chuyển đổi tên key thành KeyCode enum
                local keyCode = Enum.KeyCode[bind.key]
                if keyCode then
                    keybinds[keyCode] = bind.emoteId
                    emoteKeybinds[bind.emoteId] = keyCode
                    print("⌨️ Loaded keybind: " .. bind.key .. " -> " .. bind.emoteId)
                end
            end
        end
    end
end

-- FIXED: Save/Load settings
local function saveSettings()
