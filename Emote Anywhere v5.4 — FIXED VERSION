LP.CharacterAdded:Connect(function(c)
    Char = c
    Hum = c:WaitForChild("Humanoid")
    Animator = Hum:WaitForChild("Animator")
    
    -- Wait for character to fully load
    task.wait(2)
    
    -- Resume last emote if was locked
    if lastPlayedEmoteId and isLocked then
        print("[DEBUG] Resuming emote after respawn:", lastPlayedEmoteId)
        local track, err = PlayEmoteDirect(lastPlayedEmoteId)
        if track then
            isLocked = true
            startLoop()
            
            local emote = findEmoteById(lastPlayedEmoteId)
            if emote then
                SL.Text = "🔄 Resumed: " .. emote.name
                SL.TextColor3 = Color3.fromRGB(100, 200, 255)
            end
        else
            print("[DEBUG] Failed to resume emote:", err)
        end
    end
end)

