                unlockKeybind = Enum.KeyCode[data.unlockKey]
                print("🔓 Loaded unlock key: " .. data.unlockKey)
            end
        end
    end
end

-- =============================================
-- KEYBIND MANAGEMENT
-- =============================================
local function getKeybindForEmote(emoteId)
    return emoteKeybinds[emoteId]
end

local function setKeybind(emoteId, keyCode)
    -- Prevent using unlock key for emotes
    if keyCode == unlockKeybind then
        return false, "Phím này đã dùng cho Unlock!"
    end
    
    local oldKey = emoteKeybinds[emoteId]
    if oldKey then
        keybinds[oldKey] = nil
    end
    
    local oldEmote = keybinds[keyCode]
    if oldEmote then
        emoteKeybinds[oldEmote] = nil
    end
    
    keybinds[keyCode] = emoteId
    emoteKeybinds[emoteId] = keyCode
    saveKeybinds()
    return true
end

local function removeKeybind(emoteId)
    local keyCode = emoteKeybinds[emoteId]
    if keyCode then
        keybinds[keyCode] = nil
        emoteKeybinds[emoteId] = nil
        saveKeybinds()
    end
end

local function setUnlockKeybind(keyCode)
    if keybinds[keyCode] then
        return false, "Phím này đã gán cho emote!"
    end
    
    unlockKeybind = keyCode
    saveSettings()
    return true
end

local function getKeyName(keyCode)
    local name = tostring(keyCode):gsub("Enum.KeyCode.", "")
    if name:find("^%w$") then
        return name
    end
    return name
end

-- =============================================
-- EMOTE MANAGEMENT
-- =============================================
local function isFavorite(emoteId)
    for _, fav in ipairs(favorites) do
        if fav == emoteId then return true end
    end
    return false
end

local function toggleFavorite(emoteId)
    if isFavorite(emoteId) then
        for i, fav in ipairs(favorites) do
            if fav == emoteId then
                table.remove(favorites, i)
                break
            end
        end
    else
        table.insert(favorites, emoteId)
    end
    saveFavorites()
end

local function isDefault(animId)
    local id = animId:match("%d+")
    for _, d in ipairs(DEFAULTS) do
        if d == id then return true end
    end
    return false
end

local function findEmoteById(emoteId)
    for _, e in ipairs(allEmotes) do
        if e.id == emoteId then return e end
    end
    return nil
end

local function getAllEmotes()
    allEmotes = {}
    for _, p in ipairs(defaultPresets) do
        table.insert(allEmotes, {
            name = p.name,
            id = p.id,
            default = true,
            custom = false
        })
    end
    for _, c in ipairs(customEmotes) do
        table.insert(allEmotes, {
            name = c.name,
            id = c.id,
            default = false,
            custom = true
        })
    end
end

local function addCustomEmote(name, id)
    for _, e in ipairs(customEmotes) do
        if e.id == id then
            return false, "ID này đã tồn tại!"
        end
    end
    table.insert(customEmotes, { name = name, id = id })
    saveCustomEmotes()
    getAllEmotes()
    return true, "Đã thêm " .. name
end

local function removeCustomEmote(id)
    for i, e in ipairs(customEmotes) do
        if e.id == id then
            table.remove(customEmotes, i)
            saveCustomEmotes()
            getAllEmotes()
            return true
        end
    end
    return false
end

-- =============================================
-- PLAY EMOTE
-- =============================================
local function PlayEmoteDirect(animId)
    if not Char or not Hum or not Animator then
        return nil, "Character not ready"
    end
    
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. animId
    
    local ok, track = pcall(function()
        return Animator:LoadAnimation(anim)
    end)
    
    if not ok or not track then
        return nil, "Failed to load animation"
    end
    
    -- Stop old track
    if currentTrack then
        pcall(function() currentTrack:Stop() end)
    end
    
    currentTrack = track
    track:Play()
    return track
end

local function unlockEmote()
    if currentTrack then
        pcall(function() currentTrack:Stop() end)
        currentTrack = nil
    end
    isLocked = false
    isPaused = false
    if loopConn then
        loopConn:Disconnect()
        loopConn = nil
    end
    return true
end

local function startLoop()
    if loopConn then loopConn:Disconnect() end
    loopConn = RunService.Heartbeat:Connect(function()
        if not isLocked or isPaused then return end
        if currentTrack and not currentTrack.IsPlaying then
            currentTrack:Play()
        end
    end)
end

