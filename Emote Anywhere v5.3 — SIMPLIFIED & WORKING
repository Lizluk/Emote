local function refreshEmoteList()
    -- Clear
    for _, child in ipairs(SF:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    -- Filter
    local filtered = {}
    for _, e in ipairs(allEmotes) do
        if currentFilter == "all" then
            table.insert(filtered, e)
        elseif currentFilter == "favorites" and isFavorite(e.id) then
            table.insert(filtered, e)
        elseif currentFilter == "custom" and e.custom then
            table.insert(filtered, e)
        end
    end
    
    -- Render
    for _, emote in ipairs(filtered) do
        local EF = Instance.new("Frame")
        EF.Size = UDim2.new(1, -10, 0, 40)
        EF.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
        EF.BorderSizePixel = 0
        EF.Parent = SF
        Instance.new("UICorner", EF).CornerRadius = UDim.new(0, 6)
        
        -- Play button
        local PlayBtn = Instance.new("TextButton")
        PlayBtn.Size = UDim2.new(0.5, 0, 1, 0)
        PlayBtn.BackgroundTransparency = 1
        PlayBtn.Text = emote.name
        PlayBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        PlayBtn.Font = Enum.Font.Gotham
        PlayBtn.TextSize = 13
        PlayBtn.TextXAlignment = Enum.TextXAlignment.Left
        PlayBtn.Parent = EF
        
        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, 10)
        pad.Parent = PlayBtn
        
        PlayBtn.MouseButton1Click:Connect(function()
            local track = PlayEmote(emote.id)
            if track then
                isLocked = true
                startLoop()
                SL.Text = "✅ " .. emote.name
                SL.TextColor3 = Color3.fromRGB(80, 255, 110)
            else
                SL.Text = "❌ Error"
                SL.TextColor3 = Color3.fromRGB(255, 80, 80)
            end
        end)
        
        -- Favorite button
        local FavBtn = Instance.new("TextButton")
        FavBtn.Size = UDim2.new(0, 35, 1, 0)
        FavBtn.Position = UDim2.new(1, -150, 0, 0)
        FavBtn.BackgroundTransparency = 1
        FavBtn.Text = isFavorite(emote.id) and "⭐" or "☆"
        FavBtn.TextColor3 = Color3.fromRGB(255, 220, 100)
        FavBtn.Font = Enum.Font.GothamBold
        FavBtn.TextSize = 18
        FavBtn.Parent = EF
        
        FavBtn.MouseButton1Click:Connect(function()
            toggleFavorite(emote.id)
            refreshEmoteList()
        end)
        
        -- Key button
        local KeyBtn = Instance.new("TextButton")
        KeyBtn.Size = UDim2.new(0, 70, 1, 0)
        KeyBtn.Position = UDim2.new(1, -110, 0, 0)
        KeyBtn.BackgroundColor3 = Color3.fromRGB(60, 100, 140)
        KeyBtn.BorderSizePixel = 0
        KeyBtn.Parent = EF
        Instance.new("UICorner", KeyBtn).CornerRadius = UDim.new(0, 4)
        
        local keyCode = emoteKeybinds[emote.id]
        if keyCode then
            KeyBtn.Text = "⌨️ " .. getKeyName(keyCode)
            KeyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            KeyBtn.Text = "Set Key"
            KeyBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        KeyBtn.Font = Enum.Font.Gotham
        KeyBtn.TextSize = 11
        
        KeyBtn.MouseButton1Click:Connect(function()
            isSettingKeybind = true
            settingKeybindFor = emote.id
            KeyBtn.Text = "Press..."
            KeyBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 30)
            SL.Text = "⌨️ Click vào game rồi nhấn phím..."
            SL.TextColor3 = Color3.fromRGB(255, 255, 100)
        end)
        
        -- Delete button (custom only)
        if emote.custom then
            local DelBtn = Instance.new("TextButton")
            DelBtn.Size = UDim2.new(0, 35, 1, 0)
            DelBtn.Position = UDim2.new(1, -35, 0, 0)
            DelBtn.BackgroundColor3 = Color3.fromRGB(140, 40, 40)
            DelBtn.Text = "🗑"
            DelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            DelBtn.Font = Enum.Font.GothamBold
            DelBtn.TextSize = 14
            DelBtn.BorderSizePixel = 0
            DelBtn.Parent = EF
            Instance.new("UICorner", DelBtn).CornerRadius = UDim.new(0, 4)
            
            DelBtn.MouseButton1Click:Connect(function()
                if removeCustomEmote(emote.id) then
                    refreshEmoteList()
                    SL.Text = "🗑 Đã xóa"
                    SL.TextColor3 = Color3.fromRGB(200, 200, 200)
                end
            end)
        end
    end
    
    SF.CanvasSize = UDim2.new(0, 0, 0, UIL.AbsoluteContentSize.Y + 10)
end

local function updateFilter(filter)
    currentFilter = filter
    AllBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    FavBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    CustomBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    
    if filter == "all" then
        AllBtn.BackgroundColor3 = Color3.fromRGB(70, 140, 70)
    elseif filter == "favorites" then
        FavBtn.BackgroundColor3 = Color3.fromRGB(70, 140, 70)
    elseif filter == "custom" then
        CustomBtn.BackgroundColor3 = Color3.fromRGB(70, 140, 70)
    end
    
    refreshEmoteList()
end

-- =============================================
-- INPUT HANDLER
-- =============================================
UserInputService.InputBegan:Connect(function(input, gp)
    -- Setting unlock key
    if isSettingUnlockKey and input.UserInputType == Enum.UserInputType.Keyboard then
        local key = input.KeyCode
        if key ~= Enum.KeyCode.Unknown and 
           key ~= Enum.KeyCode.LeftShift and key ~= Enum.KeyCode.RightShift and
           key ~= Enum.KeyCode.LeftControl and key ~= Enum.KeyCode.RightControl then
            
            if not keybinds[key] then
                unlockKeybind = key
                saveSettings()
                UnlockKeyBtn.Text = "⌨️ Unlock: " .. getKeyName(key)
                UnlockKeyBtn.BackgroundColor3 = Color3.fromRGB(60, 100, 140)
                SL.Text = "✅ Unlock key: " .. getKeyName(key)
                SL.TextColor3 = Color3.fromRGB(80, 255, 110)
            else
                SL.Text = "❌ Phím đã dùng!"
                SL.TextColor3 = Color3.fromRGB(255, 80, 80)
            end
            isSettingUnlockKey = false
        end
        return
    end
    
    -- Setting emote key
    if isSettingKeybind and settingKeybindFor and input.UserInputType == Enum.UserInputType.Keyboard then
        local key = input.KeyCode
        if key ~= Enum.KeyCode.Unknown and 
           key ~= Enum.KeyCode.LeftShift and key ~= Enum.KeyCode.RightShift and
           key ~= Enum.KeyCode.LeftControl and key ~= Enum.KeyCode.RightControl then
            
            if key == unlockKeybind then
                SL.Text = "❌ Phím này dùng cho Unlock!"
                SL.TextColor3 = Color3.fromRGB(255, 80, 80)
            else
                -- Remove old binding
                local oldKey = emoteKeybinds[settingKeybindFor]
                if oldKey then keybinds[oldKey] = nil end
                
                -- Remove if key used by other emote
                local oldEmote = keybinds[key]
                if oldEmote then emoteKeybinds[oldEmote] = nil end
                
                -- Set new binding
                keybinds[key] = settingKeybindFor
                emoteKeybinds[settingKeybindFor] = key
                saveKeybinds()
                
                local emote = findEmoteById(settingKeybindFor)
                if emote then
                    SL.Text = "✅ " .. getKeyName(key) .. " → " .. emote.name
                    SL.TextColor3 = Color3.fromRGB(80, 255, 110)
                end
            end
            isSettingKeybind = false
            settingKeybindFor = nil
            refreshEmoteList()
        end
        return
    end
    
    -- Normal usage
    if gp or UserInputService:GetFocusedTextBox() then return end
    
    if input.UserInputType == Enum.UserInputType.Keyboard then
        -- Unlock
        if input.KeyCode == unlockKeybind then
            unlockEmote()
            PauseBtn.Text = "⏸ Pause"
            PauseBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 10)
            SL.Text = "🔓 Unlocked"
            SL.TextColor3 = Color3.fromRGB(200, 200, 200)
            return
        end
        
        -- Emote
        local emoteId = keybinds[input.KeyCode]
        if emoteId then
            local emote = findEmoteById(emoteId)
            if emote then
                local track = PlayEmote(emote.id)
                if track then
                    isLocked = true
                    startLoop()
                    SL.Text = "✅ " .. emote.name
                    SL.TextColor3 = Color3.fromRGB(80, 255, 110)
                end
            end
        end
    end
end)

