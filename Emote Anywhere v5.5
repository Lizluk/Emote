-- =============================================
-- NEW: REFRESH WITH ALPHABETICAL SORTING
-- =============================================
function refreshEmoteList()
    -- Clear old
    for _, btn in ipairs(emoteButtons) do btn:Destroy() end
    emoteButtons = {}
    
    -- Get emotes
    local emotes = getFilteredEmotes()
    
    if currentFilter == "favorites" then
        -- Use alphabetical grouping WITH custom order within each group
        local grouped, letters = sortEmotesAlphabetically(emotes)
        
        -- For each letter group, sort by custom order
        for letter, emotesInGroup in pairs(grouped) do
            -- Ensure all emotes in this group have order
            for _, emote in ipairs(emotesInGroup) do
                ensureEmoteInOrder(emote.id)
            end
            
            -- Sort within group by custom order
            table.sort(emotesInGroup, function(a, b)
                return getEmoteOrder(a.id) < getEmoteOrder(b.id)
            end)
        end
        
        -- Create headers and buttons
        local orderIndex = 0
        for _, letter in ipairs(letters) do
            -- Create header
            local header = createLetterHeader(letter, orderIndex)
            table.insert(emoteButtons, header)
            orderIndex = orderIndex + 1
            
            -- Create emotes for this letter (with up/down buttons)
            for _, emote in ipairs(grouped[letter]) do
                local btn = createEmoteButton(emote, orderIndex)
                table.insert(emoteButtons, btn)
                orderIndex = orderIndex + 1
            end
        end
        
        -- Update canvas size
        local totalHeight = 0
        for _, btn in ipairs(emoteButtons) do
            totalHeight = totalHeight + btn.Size.Y.Offset + 3
        end
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
    else
        -- Use alphabetical sort for other filters
        local grouped, letters = sortEmotesAlphabetically(emotes)
        
        -- Create headers and buttons
        local orderIndex = 0
        for _, letter in ipairs(letters) do
            -- Create header
            local header = createLetterHeader(letter, orderIndex)
            table.insert(emoteButtons, header)
            orderIndex = orderIndex + 1
            
            -- Create emotes for this letter
            for _, emote in ipairs(grouped[letter]) do
                local btn = createEmoteButton(emote, orderIndex)
                table.insert(emoteButtons, btn)
                orderIndex = orderIndex + 1
            end
        end
        
        -- Update canvas size
        local totalHeight = 0
        for _, btn in ipairs(emoteButtons) do
            totalHeight = totalHeight + btn.Size.Y.Offset + 3
        end
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
    end
end

local function updateFilter(filter)
    currentFilter = filter
    AllBtn.BackgroundColor3 = (filter == "all") and Color3.fromRGB(80, 50, 150) or Color3.fromRGB(40, 40, 60)
    FavBtn.BackgroundColor3 = (filter == "favorites") and Color3.fromRGB(80, 50, 150) or Color3.fromRGB(40, 40, 60)
    CustomBtn.BackgroundColor3 = (filter == "custom") and Color3.fromRGB(80, 50, 150) or Color3.fromRGB(40, 40, 60)
    refreshEmoteList()
end

