local function saveHiddenDefaults()
    ensureFolder()
    writefile(HIDDEN_DEFAULTS_PATH, HttpService:JSONEncode(hiddenDefaults))
end

local function loadHiddenDefaults()
    ensureFolder()
    if isfile(HIDDEN_DEFAULTS_PATH) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(HIDDEN_DEFAULTS_PATH))
        end)
        if ok and data then hiddenDefaults = data end
    end
end

local function isHidden(emoteId)
    for _, hidden in ipairs(hiddenDefaults) do
        if hidden == emoteId then return true end
    end
    return false
end

local function hideDefaultEmote(id)
    if not isHidden(id) then
        table.insert(hiddenDefaults, id)
        saveHiddenDefaults()
        removeKeybind(id)
        -- Also remove from favorites if it was favorited
        for i, fav in ipairs(favorites) do
            if fav == id then
                table.remove(favorites, i)
                saveFavorites()
                break
            end
        end
    end
    return true
end

local function unhideDefaultEmote(id)
    for i, hidden in ipairs(hiddenDefaults) do
        if hidden == id then
            table.remove(hiddenDefaults, i)
            saveHiddenDefaults()
            return true
        end
    end
    return false
end

