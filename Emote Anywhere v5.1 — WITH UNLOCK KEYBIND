        local KeyBtn = Instance.new("TextButton")
        KeyBtn.Size = UDim2.new(0, 70, 1, 0)
        KeyBtn.Position = UDim2.new(1, -110, 0, 0)
        KeyBtn.BackgroundColor3 = Color3.fromRGB(60, 100, 140)
        KeyBtn.BorderSizePixel = 0
        KeyBtn.Parent = EF
        
        local KC = Instance.new("UICorner")
        KC.CornerRadius = UDim.new(0, 4)
        KC.Parent = KeyBtn
        
        local keyCode = getKeybindForEmote(emote.id)
        if keyCode then
            KeyBtn.Text = "⌨️ " .. getKeyName(keyCode)
            KeyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            KeyBtn.Text = "Set Key"
            KeyBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        KeyBtn.Font = Enum.Font.Gotham
        KeyBtn.TextSize = 11
        
        KeyBtn.MouseButton1Click:Connect(function()
