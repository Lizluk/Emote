local function saveKeybinds()
    ensureFolder()
    local saveData = {}
    for keyCode, emoteId in pairs(keybinds) do
        local keyName = tostring(keyCode):gsub("Enum.KeyCode.", "")
        table.insert(saveData, { key = keyName, emoteId = emoteId })
    end
    writefile(KEYBINDS_PATH, HttpService:JSONEncode(saveData))
end

local function loadKeybinds()
    ensureFolder()
    if isfile(KEYBINDS_PATH) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(KEYBINDS_PATH))
        end)
        if ok and data then
            keybinds = {}
            emoteKeybinds = {}
            for _, bind in ipairs(data) do
                local keyCode = Enum.KeyCode[bind.key]
                if keyCode then
                    keybinds[keyCode] = bind.emoteId
                    emoteKeybinds[bind.emoteId] = keyCode
                end
            end
        end
    end
end

local function saveSettings()
    ensureFolder()
    local settings = {
        unlockKey = unlockKeybind and tostring(unlockKeybind):gsub("Enum.KeyCode.", "") or nil,
        lastEmoteId = lastPlayedEmoteId,
        wasLocked = isLocked,
        autoResume = autoResumeEnabled
    }
    writefile(SETTINGS_PATH, HttpService:JSONEncode(settings))
end

local function loadSettings()
    ensureFolder()
    if isfile(SETTINGS_PATH) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(SETTINGS_PATH))
        end)
        if ok and data then
            if data.unlockKey then
                unlockKeybind = Enum.KeyCode[data.unlockKey]
            end
            if data.lastEmoteId then
                lastPlayedEmoteId = data.lastEmoteId
            end
            if data.autoResume ~= nil then
                autoResumeEnabled = data.autoResume
            end
            return data.wasLocked or false
        end
    end
    return false
end

-- =============================================
-- KEYBIND & EMOTE MANAGEMENT (same as before)
-- =============================================
local function getKeybindForEmote(emoteId)
    return emoteKeybinds[emoteId]
end

local function setKeybind(emoteId, keyCode)
    if keyCode == unlockKeybind then
        return false, "Phím này đã dùng cho Unlock!"
    end
    
    local oldKey = emoteKeybinds[emoteId]
    if oldKey then keybinds[oldKey] = nil end
    
    local oldEmote = keybinds[keyCode]
    if oldEmote then emoteKeybinds[oldEmote] = nil end
    
    keybinds[keyCode] = emoteId
    emoteKeybinds[emoteId] = keyCode
    saveKeybinds()
    return true
end

local function removeKeybind(emoteId)
    local keyCode = emoteKeybinds[emoteId]
    if keyCode then
        keybinds[keyCode] = nil
        emoteKeybinds[emoteId] = nil
        saveKeybinds()
    end
end

local function setUnlockKeybind(keyCode)
    if keybinds[keyCode] then
        return false, "Phím này đã gán cho emote!"
    end
    unlockKeybind = keyCode
    saveSettings()
    return true
end

local function getKeyName(keyCode)
    return tostring(keyCode):gsub("Enum.KeyCode.", "")
end

local function isFavorite(emoteId)
    for _, fav in ipairs(favorites) do
        if fav == emoteId then return true end
    end
    return false
end

local function toggleFavorite(emoteId)
    if isFavorite(emoteId) then
        for i, fav in ipairs(favorites) do
            if fav == emoteId then
                table.remove(favorites, i)
                break
            end
        end
        removeKeybind(emoteId)
    else
        table.insert(favorites, emoteId)
    end
    saveFavorites()
end

local function addCustomEmote(name, id)
    for _, emote in ipairs(customEmotes) do
        if emote.id == id then
            return false, "ID đã tồn tại!"
        end
    end
    table.insert(customEmotes, { name = name, id = id, custom = true })
    saveCustomEmotes()
    return true, "Đã thêm emote!"
end

local function removeCustomEmote(id)
    for i, emote in ipairs(customEmotes) do
        if emote.id == id then
            table.remove(customEmotes, i)
            saveCustomEmotes()
            removeKeybind(id)
            return true
        end
    end
    return false
end

